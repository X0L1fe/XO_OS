XO_OS_DATABASE_URL=sqlite:///./data/xo_os.db
XO_OS_TIMEZONE=Europe/Moscow

# Google Calendar configuration
# Path to the Google OAuth2 client secrets file (downloaded from Google Cloud Console)
XO_OS_GOOGLE_CREDENTIALS=client_secret.json
# Path to store the Google OAuth2 token (optional, defaults to ./data/token.json)
XO_OS_GOOGLE_TOKEN=token.json
# Data directory for storing token and other data (optional, defaults to ./data)
XO_OS_DATA_DIR=./data
